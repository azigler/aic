# python artifacts
__pycache__/
*.egg-info/
build/
files.txt

# pixi environments
.pixi/*
!.pixi/config.toml

# Ignore mesh/texture assets in aic_mujoco mjcf, keep only .xml
aic_utils/aic_mujoco/mjcf/*.obj
aic_utils/aic_mujoco/mjcf/*.stl
aic_utils/aic_mujoco/mjcf/*.png

# Ignore aic_isaac usd assets
aic_utils/aic_isaac/aic_isaaclab/source/aic_task/aic_task/tasks/manager_based/aic_task/Intrinsic_assets/

models/
aic_results/debug/

# Local + GPU project artifacts (kept under ~/aic/ for scoping; never committed)
data/
results/
logs/
bin/

# bv (beads viewer) local config and caches
.bv/

# beads runtime artifacts (locks, WAL, history)
.beads/.sync.lock
.beads/.write.lock
.beads/.br_history/
.beads/beads.db-wal
.beads/beads.db-shm
